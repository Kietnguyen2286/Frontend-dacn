# Railway Configuration (railway.json)

{
  "projectId": "your_project_id",
  "services": [
    {
      "name": "employee-api",
      "buildCommand": "npm install",
      "startCommand": "node src/index.js",
      "variables": {
        "PORT": "5000",
        "NODE_ENV": "production"
      }
    }
  ]
}

# Or use railway.toml

[build]
builder = "nixpacks"
buildCommand = "npm install"

[deploy]
startCommand = "node src/index.js"
restartPolicyMaxRetries = 5

# Environment variables are set in Railway dashboard
