{
  "name": "employee-management-api",
  "version": "1.0.0",
  "description": "Employee Management System API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/scripts/seedData.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest --watch",
    "test:api:build": "node tests/api/scripts/build-postman-collection.mjs",
    "test:api:run": "npm run test:api:build ; python ../test/parse_newman.py tests/api/postman_collection.json -o tests/api"
  },
  "keywords": [
    "employee",
    "management",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "newman": "^6.2.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.4"
  }
}
